{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nmsr.action-grammar/1",
  "type": "object",
  "required": [
    "schema",
    "grammar_id",
    "actions"
  ],
  "properties": {
    "schema": {
      "const": "nmsr.action-grammar/1"
    },
    "grammar_id": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "parameters",
          "preconditions",
          "effects",
          "safety_class"
        ],
        "properties": {
          "action_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "target_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "postconditions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "reversible": {
            "type": "boolean"
          },
          "undo_action_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "safety_class": {
            "enum": [
              "safe",
              "reversible",
              "destructive",
              "privileged",
              "unknown"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
