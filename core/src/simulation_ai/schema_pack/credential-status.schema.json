{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simulation-ai.local/schemas/credential-status.schema.json",
  "title": "Simulation AI Credential Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "format",
    "configured",
    "unlocked",
    "env_available",
    "source",
    "fingerprint",
    "created_at",
    "secret_exposed"
  ],
  "properties": {
    "provider": {"const": "openai"},
    "format": {"const": "simulation-ai-openai-vault-v1"},
    "configured": {"type": "boolean"},
    "unlocked": {"type": "boolean"},
    "env_available": {"type": "boolean"},
    "source": {"type": "string", "maxLength": 64},
    "fingerprint": {"type": "string", "pattern": "^$|^[a-f0-9]{12}$"},
    "created_at": {"type": "string", "maxLength": 64},
    "secret_exposed": {"const": false}
  }
}
