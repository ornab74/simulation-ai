{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nmsr.execution-plan/1",
  "title": "Bounded execution plan",
  "type": "object",
  "required": [
    "schema",
    "plan_id",
    "parent_state_hash",
    "branch",
    "steps",
    "stop_conditions",
    "rollback_strategy",
    "requires_review"
  ],
  "properties": {
    "schema": {
      "const": "nmsr.execution-plan/1"
    },
    "plan_id": {
      "type": "string"
    },
    "parent_state_hash": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rollback_strategy": {
      "type": "object"
    },
    "expected_observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "resource_estimate": {
      "type": "object"
    },
    "requires_review": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
