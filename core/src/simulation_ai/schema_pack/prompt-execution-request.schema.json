{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nmsr.prompt-execution-request/1",
  "type": "object",
  "required": [
    "prompt_id",
    "inputs"
  ],
  "properties": {
    "prompt_id": {
      "type": "string"
    },
    "inputs": {
      "type": "object"
    },
    "model": {
      "type": "string"
    },
    "reasoning_effort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 128,
      "maximum": 100000
    }
  },
  "additionalProperties": false
}
