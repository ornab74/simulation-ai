{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nmsr.workflow-repair/1",
  "type": "object",
  "required": [
    "schema",
    "workflow_run_id",
    "failure_class",
    "root_causes",
    "repair_actions",
    "retry_limit",
    "stop_conditions",
    "fallback_route",
    "requires_clarification",
    "bypassed_gates",
    "confidence"
  ],
  "properties": {
    "schema": {
      "const": "nmsr.workflow-repair/1"
    },
    "workflow_run_id": {
      "type": "string"
    },
    "failure_class": {
      "enum": [
        "missing-input",
        "provider",
        "schema",
        "semantic",
        "rights",
        "security",
        "budget",
        "deterministic-gate",
        "unknown"
      ]
    },
    "root_causes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repair_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retry_limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallback_route": {
      "enum": [
        "retry",
        "local-model",
        "deterministic-fallback",
        "clarify",
        "human-review",
        "abort"
      ]
    },
    "requires_clarification": {
      "type": "boolean"
    },
    "bypassed_gates": {
      "type": "array",
      "maxItems": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
