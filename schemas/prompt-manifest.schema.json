{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nmsr.prompt-manifest/1",
  "type": "object",
  "required": [
    "schema",
    "pack_id",
    "pack_version",
    "shared_policies",
    "max_input_bytes",
    "prompts",
    "workflows"
  ],
  "properties": {
    "schema": {
      "const": "nmsr.prompt-manifest/1"
    },
    "pack_id": {
      "type": "string"
    },
    "pack_version": {
      "type": "string"
    },
    "shared_policies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_input_bytes": {
      "type": "integer",
      "minimum": 1024
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "version",
          "file",
          "stage",
          "authority",
          "required_inputs",
          "optional_inputs",
          "task_types",
          "runtime_class",
          "callable",
          "shared_policies",
          "risk_level",
          "latency_class",
          "preferred_model_class",
          "modalities",
          "deterministic_gate_required",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "authority": {
            "type": "string"
          },
          "output_schema": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_schema_file": {
            "type": [
              "string",
              "null"
            ]
          },
          "required_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optional_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "task_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "runtime_class": {
            "type": "string"
          },
          "callable": {
            "type": "boolean"
          },
          "shared_policies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk_level": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "latency_class": {
            "type": "string"
          },
          "preferred_model_class": {
            "type": "string"
          },
          "modalities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "deterministic_gate_required": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workflow"
      }
    }
  },
  "$defs": {
    "workflow": {
      "type": "object",
      "required": [
        "id",
        "title",
        "task_types",
        "prompts",
        "deterministic_gates"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "title": {
          "type": "string"
        },
        "task_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prompts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "deterministic_gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
