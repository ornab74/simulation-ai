{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nmsr.patch-proposal/1",
  "type": "object",
  "required": [
    "schema", "proposal_id", "event_id", "parent_state_hash", "branch",
    "intent", "operations", "render_impact", "uncertainties", "requires_review", "model_id"
  ],
  "properties": {
    "schema": {"const": "nmsr.patch-proposal/1"},
    "proposal_id": {"type": "string"},
    "event_id": {"type": "string"},
    "parent_state_hash": {"type": "string"},
    "branch": {"type": "string"},
    "intent": {"type": "object"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op", "path", "evidence_ids", "epistemic_class", "confidence"],
        "properties": {
          "op": {"enum": ["test", "add", "replace", "remove"]},
          "path": {"type": "string", "pattern": "^/"},
          "value": {},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "epistemic_class": {
            "enum": ["observed", "inferred", "counterfactual", "speculative", "unknown"]
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "render_impact": {"type": "object"},
    "uncertainties": {"type": "array"},
    "requires_review": {"type": "boolean"},
    "model_id": {"type": "string"}
  },
  "additionalProperties": true
}
