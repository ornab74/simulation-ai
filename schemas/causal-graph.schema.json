{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nmsr.causal-graph/1",
  "title": "Evidence-linked causal graph",
  "type": "object",
  "required": [
    "schema",
    "graph_id",
    "nodes",
    "edges",
    "confounders",
    "unknowns"
  ],
  "properties": {
    "schema": {
      "const": "nmsr.causal-graph/1"
    },
    "graph_id": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confounders": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "testable_predictions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
