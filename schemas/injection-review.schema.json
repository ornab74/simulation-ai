{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nmsr.injection-review/1",
  "type": "object",
  "required": [
    "schema",
    "detected",
    "risk_level",
    "findings",
    "affected_boundaries",
    "recommended_handling",
    "safe_to_continue_as_data",
    "confidence"
  ],
  "properties": {
    "schema": {
      "const": "nmsr.injection-review/1"
    },
    "detected": {
      "type": "boolean"
    },
    "risk_level": {
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "source_location",
          "evidence_excerpt"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "source_location": {
            "type": "string"
          },
          "evidence_excerpt": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "affected_boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_handling": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safe_to_continue_as_data": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
