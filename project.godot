; Simulation AI — persistent world surface runtime
config_version=5

[application]
config/name="Simulation AI"
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/min_width=960
window/size/min_height=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=3

[input]
command_palette={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":75,"ctrl_pressed":true)]
}
new_branch={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":66,"ctrl_pressed":true)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
